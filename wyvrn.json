{
  "name": "zlib",
  "version": "1.4.0.0",
  "schemaVersion": 2,
  "kind": "StaticLib",
  "description": "zlib compression library",
  "dependencies": {},
  "build": {
    "system": "cmake",
    "generator": [
      "Ninja Multi-Config",
      "Visual Studio 17 2022"
    ],
    "configs": [
      "Debug",
      "Release",
      "RelWithDebInfo",
      "MinSizeRel"
    ],
    "configure": [
      "-DZLIB_BUILD_TESTING=OFF",
      "-DZLIB_MSVC_LEGACY_NAMES=ON",
      "-DCMAKE_DEBUG_POSTFIX=d",
      "-DCMAKE_RELWITHDEBINFO_POSTFIX=rd",
      "-DCMAKE_MINSIZEREL_POSTFIX=msr"
    ],
    "installDir": "install"
  },
  "compatibility": {
    "os": "exact",
    "arch": "exact",
    "compiler": "exact",
    "compiler.version": "exact-or-newer",
    "compiler.cppstd": "exact-or-newer",
    "compiler.runtime": "exact"
  }
}
