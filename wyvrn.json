{
  "name": "zlib",
  "version": "1.3.2.2",
  "schemaVersion": 2,
  "kind": "StaticLib",
  "description": "zlib compression library",
  "dependencies": {},
  "build": {
    "system": "cmake",
    "generator": ["Ninja Multi-Config", "Visual Studio 17 2022"],

    "configs": [
      "Debug",
      "Release",
      "RelWithDebInfo",
      "MinSizeRel"
    ],
    "configure": [
      "-DZLIB_BUILD_EXAMPLES=OFF"
    ],
    "installDir": "install"
  },
  "compatibility": {
    "os": "exact",
    "arch": "exact",
    "compiler": "exact",
    "compiler.version": "exact-or-newer",
    "compiler.cppstd": "exact-or-newer",
    "compiler.runtime": "exact"
  }
}
